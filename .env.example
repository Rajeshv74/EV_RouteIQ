# EV RouteIQ — Environment Variables
# Copy this file to .env and fill in your keys
# (The app works WITHOUT these — Open-Meteo is used as primary and needs no key)

# Optional: WeatherAPI.com key (free at weatherapi.com)
WEATHERAPI_KEY=your_weatherapi_key_here

# Optional: OpenWeatherMap key (free at openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_key_here
